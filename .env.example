# SmartRoute — required environment variables
# Copy to .env and fill in your API keys

# Provider keys (add whichever you have)
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Classifier: "keyword" (default, no download) or "deberta" (~400MB model download on first run)
CLASSIFIER=keyword

# Cascade verifier (set to "false" for routing-only mode, no verifier calls)
CASCADE_VERIFIER=true

# Benchmark concurrency (default 20 — raise if you have high rate limits)
BENCHMARK_CONCURRENCY=20

# Benchmark cost safety ceiling in USD (warns + confirms before proceeding)
BENCHMARK_COST_CEILING_USD=20.0

# Server API key — when set, all /v1/* requests require `Authorization: Bearer <key>`
# Leave empty (or unset) to run unauthenticated (local dev only)
SMARTROUTE_SERVER_API_KEY=

# Postgres connection string — leave empty to skip DB logging (JSONL only)
DATABASE_URL=postgresql://smartroute:smartroute@localhost:5432/smartroute
